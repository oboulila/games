  main {
    max-width: 1280px;
    width: 100%;
    margin: 0 auto;
    padding: 24px 20px;
    flex: 1;
  }

  /* Active Game Viewport */
  #player-section {
    display: none;
    background: #131726;
    border: 3px solid #3a86ff;
    border-radius: 10px;
    overflow: hidden;
    margin-bottom: 30px;
    box-shadow: 0 10px 35px rgba(0, 0, 0, 0.85);
  }
  #player-header {
    background: #1a2035;
    padding: 12px 18px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-bottom: 2px solid #2b3554;
    flex-wrap: wrap;
    gap: 10px;
  }
  #active-game-title {
    font-family: 'Press Start 2P', monospace;
    font-size: 12px;
    color: #ffbe0b;
  }
  .player-controls {
    display: flex;
    gap: 8px;
  }
  .btn {
    background: #2b3554;
    color: #fff;
    border: none;
    padding: 8px 12px;
    border-radius: 5px;
    font-weight: 600;
    font-size: 12px;
    cursor: pointer;
    transition: 0.15s;
    text-decoration: none;
  }
  .btn:hover { background: #3a86ff; }
  .btn-close { background: #dc2626; }
  .btn-close:hover { background: #ef4444; }

  #iframe-wrapper {
    position: relative;
    width: 100%;
    height: 620px;
    background: #000;
  }
  iframe {
    width: 100%;
    height: 100%;
    border: none;
    display: block;
  }

  /* Section Header */
  .section-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 18px;
  }
  .section-title {
    font-family: 'Press Start 2P', monospace;
    font-size: 12px;
    color: #94a3b8;
  }
  #game-count {
    font-size: 12px;
    color: #ffbe0b;
    font-weight: 700;
  }

  /* Game Grid */
  .game-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(245px, 1fr));
    gap: 18px;
  }
  .game-card {
    background: #151929;
    border: 2px solid #262e47;
    border-radius: 10px;
    overflow: hidden;
    transition: transform 0.2s, border-color 0.2s, box-shadow 0.2s;
    cursor: pointer;
    display: flex;
    flex-direction: column;
  }
  .game-card:hover {
    transform: translateY(-5px);
    border-color: #ffbe0b;
    box-shadow: 0 8px 25px rgba(255, 190, 11, 0.2);
  }
  .card-banner {
    height: 125px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 46px;
    position: relative;
  }
  .tag {
    position: absolute;
    top: 10px;
    right: 10px;
    background: rgba(0, 0, 0, 0.78);
    color: #ffbe0b;
    font-size: 10px;
    font-weight: 800;
    padding: 4px 8px;
    border-radius: 4px;
    text-transform: uppercase;
  }
  .card-body {
    padding: 14px;
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }
  .card-title {
    font-size: 16px;
    font-weight: 800;
    color: #fff;
    margin-bottom: 6px;
  }
  .card-desc {
    font-size: 12.5px;
    color: #94a3b8;
    line-height: 1.4;
    margin-bottom: 14px;
  }
  .play-btn {
    width: 100%;
    background: #ffbe0b;
    color: #0b0d14;
    font-family: 'Press Start 2P', monospace;
    font-size: 9px;
    padding: 10px;
    border: none;
    border-radius: 6px;
    cursor: pointer;
    text-align: center;
  }
  .game-card:hover .play-btn { background: #ffd147; }

  footer {
    text-align: center;
    padding: 18px;
    color: #64748b;
    font-size: 12px;
    border-top: 1px solid #1e293b;
  }

  @media (max-width: 600px) {
    #iframe-wrapper { height: 460px; }
    .logo { font-size: 12px; }
    .search-bar { width: 100%; }
  }
</style>
</head>
